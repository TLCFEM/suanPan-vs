{
  "allowScripts": {
    "@vscode/vsce-sign": true,
    "keytar": true
  },
  "author": {
    "email": "tlcfem@gmail.com",
    "name": "Theodore Chang"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "category": "suanPan",
        "command": "suanpan.run",
        "title": "Run this model in suanPan"
      },
      {
        "category": "suanPan",
        "command": "suanpan.insertCommand",
        "title": "Insert a command template"
      },
      {
        "category": "suanPan",
        "command": "suanpan.setPath",
        "title": "Set the executable path"
      },
      {
        "category": "suanPan",
        "command": "suanpan.showVersion",
        "title": "Show the command database version"
      }
    ],
    "configuration": {
      "properties": {
        "suanpan.color": {
          "default": true,
          "description": "Enable colorized output.",
          "ignoreSync": true,
          "type": "boolean"
        },
        "suanpan.container": {
          "default": "docker",
          "description": "Container runtime executable used when `suanpan.docker` is enabled. Set to `podman`, `nerdctl`, or a full path to any Docker-compatible executable.",
          "ignoreSync": true,
          "type": "string"
        },
        "suanpan.cpus": {
          "default": 0,
          "description": "Number of logical cores to use in the container. 0 means using all available cores.",
          "ignoreSync": true,
          "type": "integer"
        },
        "suanpan.diagnostics.enable": {
          "default": true,
          "description": "Enable model diagnostics.",
          "type": "boolean"
        },
        "suanpan.diagnostics.unknownReference": {
          "default": false,
          "description": "Report references to tags that are not defined in the same file. Disable when models load objects from other files.",
          "type": "boolean"
        },
        "suanpan.diagnostics.unknownType": {
          "default": true,
          "description": "Report unknown type keywords. Disable when using externally imported object types.",
          "type": "boolean"
        },
        "suanpan.directory": {
          "default": "",
          "description": "Working directory, leave empty to use the folder of the model file.",
          "ignoreSync": true,
          "type": "string"
        },
        "suanpan.docker": {
          "default": false,
          "description": "Run the model in a container.",
          "ignoreSync": true,
          "type": "boolean"
        },
        "suanpan.image": {
          "default": "tlcfem/suanpan",
          "description": "Container image to use.",
          "type": "string"
        },
        "suanpan.path": {
          "default": "",
          "description": "Path to the suanPan executable.",
          "ignoreSync": true,
          "type": "string"
        },
        "suanpan.verbose": {
          "default": false,
          "description": "Enable verbose output.",
          "ignoreSync": true,
          "type": "boolean"
        }
      },
      "title": "suanPan"
    },
    "menus": {
      "editor/title": [
        {
          "command": "suanpan.run",
          "group": "navigation",
          "when": "resourceLangId == suanPan"
        }
      ]
    },
    "grammars": [
      {
        "language": "suanPan",
        "path": "./syntaxes/syntax.json",
        "scopeName": "source.sp"
      }
    ],
    "languages": [
      {
        "aliases": [
          "suanPan"
        ],
        "configuration": "./syntaxes/language-configuration.json",
        "extensions": [
          ".sp",
          ".supan"
        ],
        "id": "suanPan"
      }
    ],
    "snippets": [
      {
        "language": "suanPan",
        "path": "./syntaxes/snippets.json"
      },
      {
        "language": "suanPan",
        "path": "./syntaxes/nz_sections.json"
      },
      {
        "language": "suanPan",
        "path": "./syntaxes/eu_sections.json"
      },
      {
        "language": "suanPan",
        "path": "./syntaxes/us_sections.json"
      }
    ]
  },
  "description": "Syntax highlighting and autocompletion for suanPan models",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.0",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "typescript": "^6.0.3"
  },
  "displayName": "suanPan",
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "images/suanPan-ua.png",
  "main": "./out/extension.js",
  "name": "suanpan",
  "overrides": {
    "css-what": "6.1.0"
  },
  "pricing": "Free",
  "publisher": "tlc",
  "repository": {
    "type": "git",
    "url": "https://github.com/TLCFEM/suanPan-vs"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "database": "python3 scripts/generate_database.py",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc --watch -p ./"
  },
  "version": "0.2.1",
  "volta": {
    "node": "24.21.0"
  }
}